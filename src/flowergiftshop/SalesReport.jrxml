<jasperReport name="Blank_A4" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="9e3d06f3-7762-4f41-9b2c-239250fc1781">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="FlowerGiftShopDB"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<query language="sql"><![CDATA[SELECT
    s.sale_id,
    c.name AS customer_name,
    p.product_name,
    s.quantity,
    s.total_price,
    s.sale_date
FROM sales s
JOIN customers c ON s.customer_id = c.customer_id
JOIN products p ON s.product_id = p.product_id
ORDER BY s.sale_date DESC]]></query>
